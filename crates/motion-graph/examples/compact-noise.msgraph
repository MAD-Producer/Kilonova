{
  "format_version": 2,
  "id": "compact_noise",
  "name": "三节点噪声",
  "english_name": "Three-node Noise",
  "working_space": "srgb",
  "alpha_mode": "straight",
  "nodes": [
    {
      "id": "uv",
      "version": 1,
      "operation": {
        "kind": "uv"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "noise",
      "version": 1,
      "operation": {
        "kind": "noise",
        "mode": "value",
        "octaves": 1
      },
      "position": [
        280,
        0
      ],
      "input_defaults": {
        "offset": {
          "type": "vec2",
          "value": [
            0,
            0
          ]
        },
        "scale": {
          "type": "float",
          "value": 8
        },
        "seed": {
          "type": "float",
          "value": 0
        }
      }
    },
    {
      "id": "output",
      "version": 1,
      "operation": {
        "kind": "color_output"
      },
      "position": [
        560,
        0
      ]
    }
  ],
  "connections": [
    {
      "from": {
        "node": "uv",
        "port": "value"
      },
      "to": {
        "node": "noise",
        "port": "coordinate"
      }
    },
    {
      "from": {
        "node": "noise",
        "port": "color"
      },
      "to": {
        "node": "output",
        "port": "color"
      }
    }
  ],
  "public_parameters": []
}
