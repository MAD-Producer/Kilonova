{
  "format_version": 2,
  "id": "compact_blend",
  "name": "渐变与噪声混合",
  "english_name": "Gradient and Noise Blend",
  "working_space": "srgb",
  "alpha_mode": "straight",
  "nodes": [
    {
      "id": "uv",
      "version": 1,
      "operation": {
        "kind": "uv"
      },
      "position": [
        0,
        160
      ]
    },
    {
      "id": "gradient",
      "version": 1,
      "operation": {
        "kind": "gradient",
        "mode": "linear"
      },
      "position": [
        260,
        0
      ],
      "input_defaults": {
        "start": {
          "type": "vec2",
          "value": [
            0,
            0.5
          ]
        },
        "end": {
          "type": "vec2",
          "value": [
            1,
            0.5
          ]
        },
        "falloff": {
          "type": "float",
          "value": 1
        },
        "a": {
          "type": "color",
          "value": [
            0.1,
            0.3,
            0.8,
            1
          ]
        },
        "b": {
          "type": "color",
          "value": [
            0.95,
            0.45,
            0.15,
            1
          ]
        }
      }
    },
    {
      "id": "noise",
      "version": 1,
      "operation": {
        "kind": "noise",
        "mode": "perlin",
        "octaves": 3
      },
      "position": [
        260,
        400
      ],
      "input_defaults": {
        "offset": {
          "type": "vec2",
          "value": [
            0,
            0
          ]
        },
        "scale": {
          "type": "float",
          "value": 8
        },
        "seed": {
          "type": "float",
          "value": 0
        }
      }
    },
    {
      "id": "blend",
      "version": 1,
      "operation": {
        "kind": "blend",
        "mode": "soft_light"
      },
      "position": [
        540,
        200
      ],
      "input_defaults": {
        "factor": {
          "type": "float",
          "value": 0.75
        }
      }
    },
    {
      "id": "output",
      "version": 1,
      "operation": {
        "kind": "color_output"
      },
      "position": [
        820,
        200
      ]
    }
  ],
  "connections": [
    {
      "from": {
        "node": "uv",
        "port": "value"
      },
      "to": {
        "node": "gradient",
        "port": "coordinate"
      }
    },
    {
      "from": {
        "node": "uv",
        "port": "value"
      },
      "to": {
        "node": "noise",
        "port": "coordinate"
      }
    },
    {
      "from": {
        "node": "gradient",
        "port": "color"
      },
      "to": {
        "node": "blend",
        "port": "backdrop"
      }
    },
    {
      "from": {
        "node": "noise",
        "port": "color"
      },
      "to": {
        "node": "blend",
        "port": "source"
      }
    },
    {
      "from": {
        "node": "blend",
        "port": "color"
      },
      "to": {
        "node": "output",
        "port": "color"
      }
    }
  ],
  "public_parameters": []
}
