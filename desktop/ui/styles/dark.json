{
  "version": 1,
  "tokens": {
    "font_family": "Microsoft YaHei",
    "colors": {
      "app": "#1D1D1D",
      "panel": "#232323",
      "raised": "#242424",
      "field": "#262626",
      "hover": "#303030",
      "pressed": "#304559",
      "border": "#3B3B3B",
      "focus": "#61A8F5",
      "icon": "#BBC2C9",
      "text": "#D1D1D1",
      "muted": "#A6A6A6",
      "disabled": "#858585",
      "error": "#E17870",
      "selected": "#304559",
      "transparent": "#00000000",
      "primary": "#0D66D1",
      "on_primary": "#FFFFFF",
      "header": "#1C1C1E",
      "keyframe": "#E3D94D",
      "camera": "#685782",
      "track.0": "#747443",
      "track.1": "#4D597F",
      "track.2": "#41623B",
      "checker.light": "#48484C",
      "checker.dark": "#3A3A3E",
      "shadow": "#00000066",
      "dock": "#181818",
      "well": "#171717",
      "curve": "#76C46A",
      "path.draft": "#FFBC5C",
      "context.background": "#F4F4F4",
      "context.foreground": "#171717",
      "context.muted": "#8A8A8A",
      "context.hover": "#E2E2E2",
      "context.border": "#A6A6A6"
    },
    "sizes": {
      "font.body": 12,
      "font.caption": 10,
      "font.title": 18,
      "padding": 5,
      "padding.panel": 8,
      "border": 1,
      "motion.hover_ms": 90,
      "motion.divider_ms": 100,
      "motion.seek_ms": 90,
      "motion.value_ms": 140,
      "font.small": 11,
      "panel.header.height": 24,
      "row.height": 22,
      "viewer.controls.height": 28,
      "viewer.field.height": 26,
      "viewer.button.height": 22,
      "viewer.canvas.bottom": 6,
      "viewer.floating.top": 30,
      "viewer.floating.bottom": 22,
      "viewer.zoom.width": 64,
      "viewer.fit.width": 40,
      "viewer.percent.width": 14,
      "viewer.controls.gap": 4,
      "viewer.time.width": 116,
      "viewer.quality.width": 68,
      "viewer.view.width": 98,
      "viewer.count.width": 74,
      "path.tools.width": 176,
      "transform.anchor.hit_radius": 12,
      "transform.rotate.hit_radius": 9,
      "transform.corner.hit_radius": 8,
      "transform.edge.hit_radius": 7,
      "camera.row.height": 28,
      "camera.field.height": 26,
      "field.height": 18,
      "label.column": 72,
      "value.min_width": 64,
      "icon.slot": 20,
      "tree.indent": 14,
      "checkbox.size": 14,
      "radius.control": 2,
      "radius.popup": 4,
      "context.menu.width": 220,
      "context.row.height": 20,
      "shadow.blur": 8,
      "shadow.offset_y": 3,
      "motion.drag_threshold": 3,
      "graph.curve_width": 2,
      "graph.handle_width": 1,
      "graph.handle_radius": 4,
      "graph.key_radius": 5,
      "graph.handle.hit_radius": 9,
      "graph.plot.header.height": 32,
      "graph.plot.footer.height": 48,
      "graph.mode.width": 100,
      "timeline.key.radius": 4,
      "timeline.key.hit_radius": 5,
      "graph.selection.outset": 3,
      "graph.selection.hit_radius": 6,
      "graph.selection.handle_size": 6,
      "graph.selection.fill_opacity": 0.05,
      "dropdown.max_width": 320,
      "dropdown.menu_min_width": 160,
      "node.dropdown.row.height": 28,
      "effect.row.height": 26,
      "effect.header.height": 30,
      "effect.watch.width": 24,
      "effect.enable.width": 28,
      "effect.action.size": 26,
      "effect.curve.width": 320,
      "effect.curve.graph_height": 320,
      "effect.curve.hit_radius": 7,
      "effect.curve.stroke_width": 1.5,
      "effect.curve.selector.width": 40,
      "effect.curve.selector.gap": 4,
      "effect.curve.reset.width": 30,
      "effect.curve.background_opacity": 0.5,
      "effect.curve.grid_opacity": 0.25,
      "effect.curve.diagonal_opacity": 0.35,
      "auxiliary.control.height": 26,
      "auxiliary.content.height": 500,
      "auxiliary.action.width": 28,
      "auxiliary.transport.width": 36,
      "auxiliary.gap": 6,
      "icon.small.size": 14,
      "path.handle.opacity": 0.7,
      "path.selection.node_size": 8,
      "path.selection.fill_opacity": 0.12,
      "effect.toolbar.height": 28,
      "effect.toolbar.gap": 6,
      "effect.secondary.height": 24,
      "effect.secondary.gap": 4,
      "effect.category.height": 28,
      "effect.category.gap": 4,
      "effect.library.tab_width": 54,
      "effect.library.tab_gap": 4,
      "effect.group.gap": 8,
      "effect.search.width": 450,
      "effect.search.row.height": 32,
      "effect.search.field.height": 36,
      "effect.search.max_rows": 10,
      "timeline.property.group_offset": 78,
      "timeline.property.watch_offset": 98,
      "timeline.property.caption_offset": 118,
      "timeline.property.watch_width": 14,
      "timeline.property.icon_size": 16,
      "timeline.scrollbar.thumb.height": 6,
      "timeline.scrollbar.thumb.min_width": 24,
      "timeline.scrollbar.thumb.radius": 3,
      "timeline.scrollbar.inset": 4,
      "tree.separator.width": 0.5,
      "tree.separator.opacity": 0.75,
      "timeline.layer.name_offset": 112,
      "timeline.layer.wide_columns_width": 398,
      "timeline.layer.compact_columns_width": 320,
      "timeline.layer.wide_threshold": 500,
      "timeline.layer.blend_width": 76,
      "property.anchor.step": 0.5,
      "dialog.notice.width": 480,
      "dialog.notice.max_height": 320,
      "dialog.notice.button_width": 96,
      "preferences.width": 512,
      "preferences.max_height": 492,
      "preferences.margin": 16,
      "preferences.label_width": 180,
      "preferences.button_width": 96,
      "preferences.section_gap": 12,
      "preferences.sidebar_width": 100,
      "preferences.sidebar_breakpoint": 440,
      "node.add_menu.width": 512,
      "node.add_menu.height": 440,
      "node.add_menu.category_width": 128,
      "node.search.result_height": 44,
      "node.search.detail_height": 76,
      "node.search.compact_detail_height": 58,
      "node.minimap.width": 180,
      "node.minimap.height": 112,
      "node.minimap.margin": 8,
      "node.minimap.padding": 6,
      "node.minimap.world_padding": 32,
      "node.minimap.viewport_opacity": 0.10,
      "node.rename.width": 360,
      "node.rename.height": 172,
      "node.rename.padding": 12,
      "node.rename.row": 28,
      "node.rename.gap": 8,
      "node.rename.button_width": 90
    },
    "motion": {
      "easing": "cubic-out"
    }
  },
  "styles": {
    "widget": {
      "background": "$colors.transparent",
      "foreground": "$colors.text",
      "border": "$colors.transparent",
      "border_width": 0,
      "padding": "$sizes.padding",
      "font_size": "$sizes.font.body"
    },
    "panel": {
      "extends": "widget",
      "background": "$colors.panel",
      "border": "$colors.border",
      "border_width": "$sizes.border",
      "padding": "$sizes.padding.panel"
    },
    "panel.header": {
      "extends": "panel",
      "background": "$colors.header",
      "padding": 8,
      "states": {
        "focused": {
          "border": "$colors.focus"
        }
      },
      "font_size": "$sizes.font.small"
    },
    "toolbar": {
      "extends": "panel.header"
    },
    "canvas": {
      "extends": "panel",
      "background": "$colors.raised"
    },
    "canvas.content": {
      "extends": "panel",
      "background": "$colors.app",
      "border_width": 0
    },
    "label": {
      "extends": "widget"
    },
    "label.muted": {
      "extends": "label",
      "foreground": "$colors.muted"
    },
    "label.accent": {
      "extends": "label",
      "foreground": "$colors.focus"
    },
    "label.caption": {
      "extends": "label.muted",
      "font_size": "$sizes.font.caption"
    },
    "label.title": {
      "extends": "label",
      "font_size": "$sizes.font.title"
    },
    "button": {
      "extends": "widget",
      "background": "$colors.field",
      "border": "$colors.border",
      "border_width": "$sizes.border",
      "states": {
        "hovered": {
          "background": "$colors.hover"
        },
        "pressed": {
          "background": "$colors.pressed"
        },
        "focused": {
          "border": "$colors.focus"
        },
        "disabled": {
          "background": "$colors.panel",
          "foreground": "$colors.disabled",
          "border_width": 0
        }
      },
      "radius": "$sizes.radius.control"
    },
    "button.icon": {
      "extends": "widget",
      "foreground": "$colors.icon",
      "padding": 2,
      "states": {
        "hovered": {
          "background": "$colors.hover",
          "foreground": "$colors.text"
        },
        "pressed": {
          "background": "$colors.pressed"
        },
        "selected": {
          "background": "$colors.selected",
          "foreground": "$colors.focus"
        },
        "focused": {
          "border": "$colors.focus",
          "border_width": 1
        },
        "disabled": {
          "foreground": "$colors.disabled"
        }
      }
    },
    "icon": {
      "extends": "widget",
      "foreground": "$colors.icon",
      "states": {
        "selected": {
          "foreground": "$colors.focus"
        },
        "disabled": {
          "foreground": "$colors.disabled"
        }
      }
    },
    "button.primary": {
      "extends": "button",
      "background": "$colors.primary",
      "foreground": "$colors.on_primary",
      "states": {
        "hovered": {
          "background": "$colors.focus"
        }
      }
    },
    "field": {
      "extends": "widget",
      "background": "$colors.field",
      "border": "$colors.border",
      "border_width": "$sizes.border",
      "states": {
        "hovered": {
          "border": "$colors.muted"
        },
        "focused": {
          "border": "$colors.focus"
        },
        "invalid": {
          "border": "$colors.error"
        },
        "disabled": {
          "foreground": "$colors.disabled",
          "border": "$colors.border"
        }
      },
      "radius": "$sizes.radius.control"
    },
    "field.number": {
      "extends": "field",
      "background": "$colors.transparent",
      "foreground": "$colors.focus",
      "border_width": 0,
      "states": {
        "focused": {
          "background": "$colors.field",
          "border_width": "$sizes.border"
        },
        "invalid": {
          "border_width": "$sizes.border"
        }
      },
      "radius": "$sizes.radius.control",
      "font_size": "$sizes.font.small"
    },
    "selection": {
      "extends": "widget",
      "background": "$colors.selected"
    },
    "row": {
      "extends": "widget",
      "font_size": "$sizes.font.small",
      "states": {
        "hovered": {
          "background": "$colors.hover"
        },
        "selected": {
          "background": "$colors.selected",
          "foreground": "$colors.on_primary"
        },
        "focused": {
          "border": "$colors.focus",
          "border_width": 1
        },
        "disabled": {
          "foreground": "$colors.disabled"
        }
      }
    },
    "timeline.row": {
      "extends": "row"
    },
    "timeline.row.alternate": {
      "extends": "timeline.row",
      "background": "$colors.raised"
    },
    "timeline.grid": {
      "extends": "widget",
      "border": "$colors.header",
      "border_width": "$sizes.border"
    },
    "color_well": {
      "extends": "button",
      "padding": "$sizes.border"
    },
    "menu": {
      "extends": "panel",
      "background": "$colors.raised"
    },
    "tooltip": {
      "extends": "panel",
      "font_size": "$sizes.font.caption"
    },
    "error": {
      "extends": "label.caption",
      "foreground": "$colors.error"
    },
    "label.small": {
      "extends": "label",
      "font_size": "$sizes.font.small"
    },
    "checkbox": {
      "extends": "button",
      "radius": "$sizes.radius.control",
      "states": {
        "selected": {
          "background": "$colors.focus",
          "foreground": "$colors.on_primary"
        },
        "disabled": {
          "foreground": "$colors.disabled",
          "background": "$colors.panel"
        },
        "invalid": {
          "border": "$colors.error",
          "border_width": 1
        }
      }
    },
    "popup": {
      "extends": "panel",
      "background": "$colors.raised",
      "radius": "$sizes.radius.popup",
      "shadow_color": "$colors.shadow",
      "shadow_blur": "$sizes.shadow.blur",
      "shadow_offset_y": "$sizes.shadow.offset_y"
    },
    "context_menu": {
      "extends": "popup",
      "background": "$colors.context.background",
      "foreground": "$colors.context.foreground",
      "border": "$colors.context.border",
      "border_width": 1
    },
    "context_menu.row": {
      "extends": "row",
      "foreground": "$colors.context.foreground",
      "states": {
        "hovered": {
          "background": "$colors.context.hover"
        },
        "selected": {
          "background": "$colors.context.hover",
          "foreground": "$colors.context.foreground"
        },
        "disabled": {
          "foreground": "$colors.context.muted"
        }
      }
    },
    "label.small.muted": {
      "extends": "label.small",
      "foreground": "$colors.muted"
    },
    "effect.header": {
      "extends": "row",
      "background": "$colors.header",
      "states": {
        "selected": {
          "background": "$colors.selected"
        }
      }
    },
    "timeline.property.group": {
      "extends": "timeline.row",
      "background": "$colors.header",
      "foreground": "$colors.text"
    }
  }
}
