{
  "format_version": 1,
  "sdk_version": 6,
  "id": "example.motionstudio.chroma-key",
  "version": "0.1.0",
  "name": "色度抠像 API 样例 / Chroma Key API Example",
  "author": "Motion Studio contributors",
  "license": "MIT",
  "effects": [
    {
      "id": "chroma_key",
      "name": "色度抠像",
      "english_name": "Chroma Key",
      "category": "Compositing",
      "params": [
        {
          "id": "key_color",
          "name": "背景颜色",
          "kind": "color",
          "default": [0, 1, 0, 1],
          "min": 0,
          "max": 1,
          "step": 0.01,
          "animatable": true
        },
        {
          "id": "tolerance",
          "name": "颜色容差",
          "kind": "float",
          "default": [0.2, 0, 0, 0],
          "min": 0,
          "max": 1.5,
          "step": 0.001,
          "animatable": true
        },
        {
          "id": "softness",
          "name": "过渡宽度",
          "kind": "float",
          "default": [0.3, 0, 0, 0],
          "min": 0,
          "max": 1.5,
          "step": 0.001,
          "animatable": true
        },
        {
          "id": "spill",
          "name": "溢色抑制",
          "kind": "float",
          "default": [1, 0, 0, 0],
          "min": 0,
          "max": 1,
          "step": 0.01,
          "animatable": true
        }
      ],
      "passes": [{"shader": "shaders/key.wgsl", "entry": "main_fx"}],
      "working_space": "linear",
      "alpha_mode": "straight",
      "edge_mode": "transparent",
      "required_capabilities": ["single_frame", "color_profile"]
    }
  ]
}
